sealed interface Shape
    data class Circle(val field0: Int) : Shape
    data class Rect(val field0: Int, val field1: Int) : Shape
object FluxTheme {
    val colorPrimary = Color(0xFF6750A4)
    val colorSecondary = Color(0xFF625B71)
    val colorSurface = Color(0xFFFEF7FF)
    val spaceSm = 4.dp
    val spaceMd = 8.dp
    val spaceLg = 16.dp
    val textBody = 17.sp
    val textTitle = 28.sp
}


@Composable fun AreaView(
     shape: Shape
) {
    Column {
        when (shape) {
            is Circle ->
                val r = shape.field0
                Text("circle")
            is Rect ->
                val w = shape.field0
                val h = shape.field1
                Text("rect")
        }
    }
}
