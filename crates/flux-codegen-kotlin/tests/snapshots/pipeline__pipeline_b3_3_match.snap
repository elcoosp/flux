@Composable fun AreaView(
     shape: Shape
) {
    Column {
        when (shape) {
            is Circle ->
                val r = shape.field0
                Text("circle")
            is Rect ->
                val w = shape.field0
                val h = shape.field1
                Text("rect")
        }
    }
}
