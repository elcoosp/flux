import SwiftUI
enum FluxTheme {
    static let colorPrimary = Color(red: 0.404, green: 0.314, blue: 0.643)
    static let colorSecondary = Color(red: 0.384, green: 0.357, blue: 0.443)
    static let colorSurface = Color(red: 0.996, green: 0.969, blue: 1.0)
    static let spaceSm: CGFloat = 4
    static let spaceMd: CGFloat = 8
    static let spaceLg: CGFloat = 16
    static let textBody: CGFloat = 17
    static let textTitle: CGFloat = 28
}

struct App: View {
    @State private var route = NavigationPath()
    var body: some View {
  NavigationStack(path: $route) {
  }.navigationDestination(for: String.self) { route in
      if route == "home" {
      Text("Home")
      }
      if route == "settings" {
      Text("Settings")
      }
  }
    }
}
