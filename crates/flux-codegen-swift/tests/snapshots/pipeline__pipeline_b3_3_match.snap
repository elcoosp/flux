enum Shape {
 case Circle(field0: Int)
 case Rect(field0: Int, field1: Int)
}

struct AreaView: View {
    let shape: Shape
    var body: some View {
  VStack {
      switch shape {
          case let .Circle(r):
              Text("circle")
          case let .Rect(w, h):
              Text("rect")
      }
  }
    }
}
