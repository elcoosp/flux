<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Dev mode connects to the dev server over WebSocket. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="Flux"
        android:supportsRtl="true"
        android:theme="@style/Theme.Flux"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".FluxHostActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FLUX-045 Background capability: WorkManager handles the background
             work (no manifest entry required). -->
    </application>

</manifest>
