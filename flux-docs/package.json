{
  "name": "flux-docs",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Documentation site for Flux — a write-once UI language for native iOS and Android.",
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm og:compile && astro build && pnpm run generate:llms",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "markdownlint-cli2 \"src/content/docs/**/*.{md,mdx}\"",
    "generate:llms": "node scripts/generate-llms.mjs",
    "og:compile": "./node_modules/.bin/esbuild src/og-render.jsx --loader:.jsx=jsx --jsx=automatic --format=esm --outfile=src/og-render.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/starlight": "^0.42.10",
    "astro": "^7.4.7",
    "sharp": "^0.35.5",
    "starlight-heading-badges": "^0.8.0",
    "starlight-image-zoom": "^0.16.2",
    "starlight-links-validator": "^0.27.0",
    "linkedom": "^0.18.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@fontsource/roboto": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro-takumi": "github:elcoosp/astro-takumi#c4b8331abb1dc2f157d62fba634eeb17f5e689cd",
    "esbuild": "^0.28.2",
    "markdownlint-cli2": "^0.24.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
