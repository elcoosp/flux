---
// Root landing at `/`. Flux docs ship `en` and `es`; the bare root redirects to
// the user's preferred supported locale (defaulting to `en`). This runs at
// request time in dev and as a small client-side redirect in the static build
// (no middleware/SSR needed), mirroring Starlight's own locale negotiation.
const SUPPORTED = ['en', 'es'];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Flux</title>
    <script is:inline>
      (() => {
        const supported = ['en', 'es', 'fr'];
        const prefers = (navigator.languages || [navigator.language || 'en'])
          .map((t) => String(t).split('-')[0].toLowerCase());
        const match = prefers.find((l) => supported.includes(l)) || 'en';
        // Replace history so the redirect is transparent (no extra back entry).
        window.location.replace('/' + match + '/');
      })();
    </script>
  </head>
  <body>
    <p>Redirecting to <a href="/en/">the Flux documentation</a>…</p>
  </body>
</html>
