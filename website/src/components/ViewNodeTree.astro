---
import { getTranslation } from './i18n-helper';

interface Props {
  tree: {
    root: number;
    nodes: Record<string, {
      id: number;
      kind: string;
      componentId: number;
      key: number | null;
      isPure: boolean;
      signalDeps: number[];
      children: number[];
    }>;
  };
}

const { tree } = Astro.props;
const locale = Astro.currentLocale ?? 'en';
const t = getTranslation(locale);

const layouts: Record<number, { x: number; y: number }> = {
  1: { x: 160, y: 30 },
  57: { x: 90, y: 130 },
  7: { x: 230, y: 130 },
};
---

<div class="view-tree">
  <h4>{t['tracePlayer.viewTree.title']}</h4>
  <svg viewBox="0 0 320 200" role="img" aria-label={t['tracePlayer.viewTree.title']}>
    {
      Object.values(tree.nodes).map((node) => {
        const pos = layouts[node.id] ?? { x: 160, y: 110 };
        return (
          <g>
            <rect
              x={pos.x - 50}
              y={pos.y - 18}
              width={100}
              height={36}
              rx={8}
              fill="#1e293b"
              stroke="#0f172a"
              stroke-width="1.5"
            />
            <text x={pos.x} y={pos.y + 4} text-anchor="middle" fill="#e2e8f0" font-size="12">
              {node.kind} #{node.id}
            </text>
          </g>
        );
      })
    }
    {
      tree.nodes[String(tree.root)]?.children.map((childId) => {
        const c = layouts[childId];
        const r = layouts[tree.root];
        if (!c || !r) return null;
        return (
          <line
            x1={r.x}
            y1={r.y + 18}
            x2={c.x}
            y2={c.y - 18}
            stroke="#475569"
            stroke-width="1.5"
          />
        );
      })
    }
  </svg>
</div>

<style>
  .view-tree svg {
    width: 100%;
    height: auto;
    background: var(--sl-color-gray-6);
    border-radius: 8px;
  }
</style>
