---
// Header override: re-implements Starlight's default header chrome and adds a
// locale-aware "Docs" link so visitors landing on the (sidebar-less) splash
// homepage can reach the documentation. Starlight's built-in Header has no slot
// for injected content, so we compose the sub-components directly.
import config from 'virtual:starlight/user-config';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import Search from 'virtual:starlight/components/Search';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';

const shouldRenderSearch =
  config.pagefind || config.components?.Search !== '@astrojs/starlight/components/Search.astro';

const locale = Astro.currentLocale ?? 'en';
const docsHref = locale === 'en' ? '/concepts/the-wire/' : `/${locale}/concepts/the-wire/`;
---

<div class="header">
  <div class="title-wrapper sl-flex">
    <SiteTitle />
  </div>
  <div class="sl-flex print:hidden">
    {shouldRenderSearch && <Search />}
  </div>
  <a class="sl-flex header-docs-link" href={docsHref}>Docs</a>
  <div class="sl-hidden md:sl-flex print:hidden right-group">
    <div class="sl-flex social-icons">
      <SocialIcons />
    </div>
    <ThemeSelect />
    <LanguageSelect />
  </div>
</div>

<style>
  .header {
    display: flex;
    gap: var(--sl-nav-gap);
    justify-content: space-between;
    align-items: center;
    height: 100%;
  }
  .header-docs-link {
    color: var(--sl-color-text-accent);
    font-weight: 600;
    text-decoration: none;
    padding-inline: 0.25rem;
  }
  .header-docs-link:hover {
    text-decoration: underline;
  }
</style>
